# ==============================================================================
# LIFEBRIDGE BACKEND DOCUMENTATION & CONFIGURATION
# ==============================================================================
# 
# ─── QUICK START ──────────────────────────────────────────────────────────────
# 1. Install dependencies: npm install
# 2. Run in development: npm run dev
# 3. Build for production: npm run build && npm start
# 4. Run tests: npm test
# 
# ─── ARCHITECTURE ─────────────────────────────────────────────────────────────
# - Controllers: Thin request/response handlers (src/controllers/)
# - Services: Pure business logic (src/services/)
# - Routes: 17 module routes (src/routes/)
# - Models: 20 Mongoose schemas (src/models/)
# - Socket.io: Real-time event gateway (src/socket/)
# 
# ─── KEY API PORTALS ──────────────────────────────────────────────────────────
# - User Portal Login:  POST /api/v1/auth/login (All user roles except Admin)
# - Admin Portal Login: POST /api/v1/auth/admin/login (Super Admin only)
# - Individual Register: POST /api/v1/auth/register/individual
# - Org Register:        POST /api/v1/auth/register/organization
# 
# ─── SWAGGER API DOCS ─────────────────────────────────────────────────────────
# - Endpoint: http://localhost:5000/api-docs (When running locally)
# 
# ─── SOCKET.IO EVENTS ─────────────────────────────────────────────────────────
# - emergency:created / emergency:updated
# - blood:request_created
# - ambulance:location_update / ambulance:eta_update
# - chat:message / chat:typing / chat:read
# - notification
#
# ==============================================================================

# ===========================
# SERVER
# ===========================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# ===========================
# DATABASE
# ===========================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lifebridge?retryWrites=true&w=majority

# ===========================
# JWT
# ===========================
JWT_ACCESS_SECRET=your_super_secret_access_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================
# GOOGLE OAUTH
# ===========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ===========================
# EMAIL (SMTP)
# ===========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=LifeBridge <noreply@lifebridge.com>

# ===========================
# CLOUDINARY
# ===========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===========================
# RAZORPAY
# ===========================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ===========================
# GEMINI AI
# ===========================
GEMINI_API_KEY=your_gemini_api_key

# ===========================
# FIREBASE (FCM)
# ===========================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# ===========================
# OTP / SMS
# ===========================
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================
# RATE LIMITING
# ===========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===========================
# BCRYPT
# ===========================
BCRYPT_SALT_ROUNDS=12

# ===========================
# SESSION / COOKIE
# ===========================
SESSION_SECRET=your_session_secret_here
COOKIE_DOMAIN=localhost
