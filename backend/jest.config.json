{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/src/tests"],
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.tsx?$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "coverageDirectory": "coverage",
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/tests/**",
    "!src/server.ts"
  ]
}
